---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';

const faqs = [
  ['¿Cómo entregan un presupuesto en AXION?', 'Partimos con una conversación técnica breve para mapear el proceso manual. Luego entregamos una propuesta clara con alcance, plazos referenciales y un costo fijo definido antes de comenzar.'],
  ['¿Cobran suscripciones mensuales o un pago único?', 'Depende del proyecto. La construcción suele definirse como un setup de alcance fijo y el mantenimiento se ajusta a la infraestructura o integraciones que realmente se necesitan.'],
  ['¿Cuál es el tamaño mínimo de proyecto con el que trabajan en Chile?', 'Trabajamos con Pymes y grandes empresas en Santiago y regiones que tengan uno o más procesos críticos consumiendo horas de su equipo operativo.'],
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
---
<BaseLayout title="Cotización y Precios de Automatización Tecnológica en Chile | Axion" description="Entiende cómo se cotiza la automatización, el software a medida y las integraciones para empresas en Chile." canonicalPath="/precios/" structuredData={faqSchema}>
  <SiteHeader />
  <main id="contenido">
    <header class="pricing-hero"><p class="kicker">Precios y cotización</p><h1>Cotización y Precios de Automatización Tecnológica en Chile</h1><p>¿Cuánto cuesta digitalizar tu empresa? En Axion no vendemos paquetes prefabricados ni cobramos precios estándar por problemas complejos. Explicamos cómo valorizamos cada proyecto con total transparencia.</p><div class="pricing-actions"><WhatsAppCta message="Hola Axion, quiero auditar un proceso de mi empresa." label="Auditar mi proceso" /><a href="/recursos/calculadora-roi/" class="pricing-link">Calcular ROI antes de cotizar <span aria-hidden="true">→</span></a></div></header>
    <section class="pricing-pillars"><div class="pricing-section-head"><p class="kicker">Transparencia antes de cotizar</p><h2>¿De qué depende el valor de un proyecto?</h2></div><div class="pricing-pillar-grid"><article><b>01</b><h3>Complejidad y flujos</h3><p>Mapeo de procesos, OCR y reglas de negocio que determinan qué debe pasar en cada etapa.</p></article><article><b>02</b><h3>Integraciones y stack</h3><p>Conexiones con ERP, SII, CRM, APIs bancarias y las herramientas que ya sostienen tu operación.</p></article><article><b>03</b><h3>Mantención y escala</h3><p>Infraestructura sostenible, sin consumo inútil de tokens ni dependencias que no aportan valor.</p></article></div></section>
    <section class="pricing-explainer"><div><p class="kicker">Sin letra chica</p><h2>¿Por qué un precio cerrado de entrada es una mala señal?</h2></div><div class="pricing-explainer-copy"><article><h3>Evitamos costos ocultos o licencias innecesarias</h3><p>Un software preconstruido puede cobrar suscripciones fijas por usuario mientras usas una fracción de sus funciones. Diseñamos la arquitectura que tu operación realmente necesita.</p></article><article><h3>El costo real depende del retorno de inversión</h3><p>La automatización es un activo. Evaluamos la propuesta según el tiempo que puede recuperar tu equipo y el impacto que eso genera en la operación.</p></article><article><h3>Integramos lo que ya funciona</h3><p>No es lo mismo conectar un ERP complejo como SAP o Softland que sincronizar Google Sheets con WhatsApp. Auditar antes evita sobrecostos y proyectos incompletos.</p></article></div></section>
    <section class="pricing-complexity" data-complexity>
      <div class="pricing-section-head"><p class="kicker">Orientación de alcance</p><h2>Identifica el nivel de complejidad de tu desafío.</h2><p>Esto no es una cotización automática: es una forma rápida de preparar una conversación útil.</p></div>
      <div class="complexity-layout"><div class="complexity-tabs" role="tablist" aria-label="Niveles de complejidad"><button class="is-active" role="tab" aria-selected="true" data-level="simple">Nivel 1 <span>Automatización simple</span></button><button role="tab" aria-selected="false" data-level="integration">Nivel 2 <span>Integración de sistemas</span></button><button role="tab" aria-selected="false" data-level="platform">Nivel 3 <span>Software operativo</span></button></div><article class="complexity-detail" aria-live="polite"><p class="complexity-number">01</p><h3 data-complexity-title>Nivel 1: Automatización Simple</h3><p data-complexity-example><strong>Ejemplo:</strong> Captura de formularios, notificaciones inmediatas a WhatsApp o Slack y registro en CRM o Excel.</p><p data-complexity-impact><strong>Impacto:</strong> Eliminación de tareas repetitivas básicas.</p><WhatsAppCta message="Hola Axion, quiero cotizar una automatización simple." label="Cotizar este alcance" /></article></div>
    </section>
    <section class="pricing-faq"><div><p class="kicker">Preguntas de cotización</p><h2>Respuestas claras antes de invertir.</h2><WhatsAppCta message="Hola Axion, quiero cotizar un alcance a medida." label="Cotizar alcance a medida" /></div><div>{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  const data = {
    simple: { number: '01', title: 'Nivel 1: Automatización Simple', example: 'Captura de formularios, notificaciones inmediatas a WhatsApp o Slack y registro en CRM o Excel.', impact: 'Eliminación de tareas repetitivas básicas.', message: 'Hola Axion, quiero cotizar una automatización simple.' },
    integration: { number: '02', title: 'Nivel 2: Integración de Sistemas Heterogéneos', example: 'Lectura de PDF mediante visión u OCR, validación de RUT y monto en SII, y carga posterior en ERP.', impact: 'Reducción drástica del error humano en finanzas o logística.', message: 'Hola Axion, quiero cotizar una integración de sistemas.' },
    platform: { number: '03', title: 'Nivel 3: Arquitectura y Software Operativo Completo', example: 'Plataforma web a medida para turnos, acreditación minera o trazabilidad agrícola.', impact: 'Digitalización completa del núcleo del negocio.', message: 'Hola Axion, quiero cotizar una plataforma operativa a medida.' },
  };
  const root = document.querySelector<HTMLElement>('[data-complexity]');
  root?.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((button) => button.addEventListener('click', () => {
    const level = data[button.dataset.level as keyof typeof data];
    root.querySelectorAll<HTMLButtonElement>('[data-level]').forEach((tab) => { tab.classList.toggle('is-active', tab === button); tab.setAttribute('aria-selected', String(tab === button)); });
    root.querySelector<HTMLElement>('.complexity-number')!.textContent = level.number;
    root.querySelector<HTMLElement>('[data-complexity-title]')!.textContent = level.title;
    root.querySelector<HTMLElement>('[data-complexity-example]')!.innerHTML = `<strong>Ejemplo:</strong> ${level.example}`;
    root.querySelector<HTMLElement>('[data-complexity-impact]')!.innerHTML = `<strong>Impacto:</strong> ${level.impact}`;
    root.querySelector<HTMLAnchorElement>('.complexity-detail .button')!.href = `https://wa.me/56999464840?text=${encodeURIComponent(level.message)}`;
  }));
</script>
