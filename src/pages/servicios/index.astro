---
import BaseLayout from '../../layouts/BaseLayout.astro'; import SiteHeader from '../../components/SiteHeader.astro'; import SiteFooter from '../../components/SiteFooter.astro'; import { services } from '../../data/site';
const serviceIcons = ['artificial-intelligence.gif', 'backend.gif', 'responsive.gif', 'big-sale.gif', 'wired-outline-146-cart-hover-jump.gif', 'bionic-eye.gif', 'shield.gif'];
---
<BaseLayout title="Servicios de IA y automatización | Axion" description="Conoce los servicios de Axion para automatizar atención, ventas y operación."><SiteHeader /><main id="contenido" class="listing"><header class="listing-intro"><p class="kicker">Servicios Axion</p><h1>Una mejor operación empieza por resolver lo que hoy frena tu negocio.</h1><p>Elige un punto de partida. Diseñamos la solución alrededor de tus procesos, equipo y clientes.</p></header><div class="listing-grid">{services.map((service, index) => <a class:list={['listing-card', `listing-card-${index}`]} href={`/servicios/${service.slug}/`}><div class="listing-card-top"><span>0{index + 1}</span><img src={`/icons/${serviceIcons[index]}`} alt="" loading="lazy" /></div><h2>{service.name}</h2><p>{service.description}</p><strong>Conocer servicio <i aria-hidden="true">↗</i></strong></a>)}</div></main><SiteFooter /></BaseLayout>
