---
import BaseLayout from '../../layouts/BaseLayout.astro'; import SiteHeader from '../../components/SiteHeader.astro'; import SiteFooter from '../../components/SiteFooter.astro'; import WhatsAppCta from '../../components/WhatsAppCta.astro'; import ContextLink from '../../components/ContextLink.astro'; import { services } from '../../data/site';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
---
<BaseLayout title={`${service.name} | Axion`} description={service.description} canonicalPath={`/servicios/${service.slug}/`}><SiteHeader /><main id="contenido"><section class="service-hero"><p class="kicker">Servicio Axion</p><h1>{service.name}</h1><p>{service.description}</p><WhatsAppCta message={`Hola Axion, quiero conversar sobre ${service.name}.`} label="Conversar sobre este servicio" /></section><section class="section"><h2>{service.benefit}</h2><p class="service-copy">Partimos por entender cómo funciona hoy tu operación y proponemos una implementación responsable, medible y útil para tu equipo.</p><ContextLink href="/recursos/calculadora-roi/">Estimar el impacto operativo antes de partir</ContextLink><p class="notice">Alcance, plazos y valores: <strong>se definen tras el diagnóstico comercial.</strong> <ContextLink href="/precios/">Conocer cómo cotizamos</ContextLink></p></section></main><SiteFooter /></BaseLayout>
