---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhatsAppCta from '../components/WhatsAppCta.astro';
import ContextLink from '../components/ContextLink.astro';
import HeroSlider from '../components/HeroSlider.astro';
import { industries, services } from '../data/site';
const serviceIcons = ['artificial-intelligence.gif', 'backend.gif', 'responsive.gif', 'big-sale.gif', 'wired-outline-146-cart-hover-jump.gif', 'bionic-eye.gif', 'shield.gif'];
---
<BaseLayout title="Axion | IA y automatización para empresas en Chile" description="Asistentes de WhatsApp con IA, automatización y sitios web que convierten para empresas chilenas.">
  <SiteHeader />
  <main id="contenido">
    <HeroSlider />
    <div class="ticker" aria-hidden="true"><span>WhatsApp con IA · Automatización · Sitios que venden · SEO local · Ecommerce · Sistemas a medida · </span></div>
    <section class="section"><div class="section-head"><p class="kicker">Lo que hacemos</p><h2>Menos trabajo repetido. Más oportunidades atendidas.</h2><p>Soluciones conectadas a la forma real en que funciona tu empresa, sin promesas de humo.</p></div><div class="service-grid">{services.map((service, index) => <a class:list={['service-card', `service-${index}`]} href={`/servicios/${service.slug}/`}><span>0{index + 1}</span><img class="service-icon" src={`/icons/${serviceIcons[index]}`} alt="" loading="lazy" /><h3>{service.name}</h3><p>{service.benefit}</p><i aria-hidden="true">↗</i></a>)}</div></section>
    <section class="visual-strip" aria-label="Universo visual de Axion"><figure><img src="/img/YellowPad_a_minimalist_high_angle_illustration_featuring_a_si_e631557a-f03e-4d77-8af3-5a7f9bbd2bb2_1.png" alt="" loading="lazy" /><figcaption>Una operación más clara empieza por una buena pregunta.</figcaption></figure><figure><img src="/img/krisvinokurova_Investments_like_art_--ar_23_--profile_chqkp5p_bc2fde62-196e-4279-97b7-94e1738f8dce_1.png" alt="" loading="lazy" /><figcaption>Automatización con intención, no por moda.</figcaption></figure><img class="visual-gif" src="/icons/wired-outline-146-cart-hover-jump.gif" alt="" loading="lazy" /></section>
    <section class="operation-scene"><div class="operation-intro"><p class="kicker">Un cambio visible</p><h2>De apagar incendios a tener una operación que responde.</h2><p>La diferencia no es trabajar más: es darle una ruta clara a cada conversación.</p><ContextLink href="/casos/">Ver simulaciones y prototipos Axion</ContextLink></div><div class="operation-board"><article class="operation-lost"><div class="operation-label"><span>Antes</span><b>La consulta se pierde</b></div><div class="message-stack"><p>¿Tienen disponibilidad esta semana?</p><p>Hola, necesito una cotización.</p><p>¿Me pueden llamar?</p></div><strong>12 consultas sin responder</strong><small>Un día ocupado puede dejar oportunidades esperando.</small></article><div class="operation-arrow" aria-hidden="true"><span>→</span><small>Axion organiza</small></div><article class="operation-win"><div class="operation-label"><span>Con Axion</span><b>La conversación avanza</b></div><div class="result-grid"><p><i>✓</i> Cotización enviada</p><p><i>✓</i> Cliente calificado</p><p><i>✓</i> Seguimiento activado</p></div><strong>4 horas agendadas</strong><small>Tu equipo recibe el contexto cuando realmente hace falta.</small></article></div></section>
    <section class="section process"><p class="kicker">Cómo partimos</p><h2>Primero entendemos el cuello de botella. Después diseñamos la solución.</h2><ol><li><b>01</b><h3>Miramos tu operación</h3><p>Detectamos dónde se pierden horas, consultas o seguimiento.</p></li><li><b>02</b><h3>Probamos contigo</h3><p>Armamos una demo útil, con tus casos reales y una ruta clara.</p></li><li><b>03</b><h3>Lanzamos y mejoramos</h3><p>Medimos, ajustamos y acompañamos el resultado mensual.</p></li></ol></section>
    <section class="industry"><p class="kicker">Sectores donde importa responder</p><h2>Hecho para negocios que viven de las consultas.</h2><div>{industries.map((industry) => <a href="/servicios/">{industry}<span>↗</span></a>)}</div></section>
    <section class="section faq"><div><p class="kicker">Preguntas frecuentes</p><h2>Sin letra chica: resolvemos lo importante antes de partir.</h2><WhatsAppCta message="Hola Axion, tengo una consulta sobre sus servicios." label="Hacer una consulta" /></div><div><details><summary>¿Necesito cambiar mi número de WhatsApp?</summary><p>No necesariamente. Revisamos el escenario de tu empresa y definimos la integración correcta con la API oficial de WhatsApp Business.</p></details><details><summary>¿El asistente reemplaza a mi equipo?</summary><p>No. Atiende lo repetitivo y ordena el contexto, para que tu equipo se enfoque en vender y resolver los casos que requieren criterio humano.</p></details><details><summary>¿Pueden conectar mis herramientas actuales?</summary><p>Evaluamos tus formularios, agenda, CRM, correo y planillas para definir conexiones útiles y sostenibles.</p></details></div></section>
  </main><SiteFooter />
</BaseLayout>
